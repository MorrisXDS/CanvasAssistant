{
  "name": "canvas-integration-dashboard",
  "version": "0.1.0",
  "description": "Offline-first academic command center for Canvas LMS",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -w",
    "dev:renderer": "vite",
    "dev:electron": "node -e \"setTimeout(() => {}, 3000)\" && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:compat": "eslint src/**/*.ts src/**/*.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "prepare": "husky",
    "postinstall": "electron-builder install-app-deps"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "canvas",
    "lms",
    "academic",
    "offline-first",
    "uoft",
    "electron"
  ],
  "author": "UofT Students",
  "license": "MIT",
  "dependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/html-to-text": "^9.0.4",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.3.1",
    "html-to-text": "^9.0.5",
    "keytar": "^7.9.0",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.6.1",
    "react-router-dom": "^7.12.0",
    "react-window": "^1.8.10",
    "rrule": "^2.8.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MorrisXDS/CanvasAssistant.git"
  },
  "bugs": {
    "url": "https://github.com/MorrisXDS/CanvasAssistant/issues"
  },
  "homepage": "https://github.com/MorrisXDS/CanvasAssistant#readme"
}
