{
  "name": "canvas-integration-dashboard",
  "version": "1.1.1",
  "description": "Offline-first academic command center for Canvas LMS",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.js || exit 0",
    "postinstall": "electron-builder install-app-deps",
    "setup": "npm install && npm run rebuild",
    "rebuild": "electron-builder install-app-deps",
    "predev": "node scripts/check-node-version.js",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -w",
    "dev:renderer": "vite",
    "dev:electron": "node -e \"setTimeout(() => {}, 3000)\" && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:compat": "eslint src/**/*.ts src/**/*.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux"
  },
  "keywords": [
    "canvas",
    "lms",
    "academic",
    "offline-first",
    "uoft",
    "electron"
  ],
  "author": {
    "name": "Morris Sun",
    "email": "mcl211204@gmail.com"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@types/archiver": "^7.0.0",
    "@types/html-to-text": "^9.0.4",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "dompurify": "^3.3.1",
    "html-to-text": "^9.0.5",
    "keytar": "^7.9.0",
    "lucide-react": "^0.562.0",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.6.1",
    "react-router-dom": "^7.12.0",
    "react-window": "^1.8.10",
    "rrule": "^2.8.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^23.0.6",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MorrisXDS/CanvasAssistant.git"
  },
  "bugs": {
    "url": "https://github.com/MorrisXDS/CanvasAssistant/issues"
  },
  "homepage": "https://github.com/MorrisXDS/CanvasAssistant#readme",
  "build": {
    "appId": "com.canvasassistant.app",
    "productName": "Canvas Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/keytar/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "build/uninstall/cleanup.ps1",
        "to": "cleanup.ps1"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Education"
    }
  }
}
