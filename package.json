{
  "name": "canvas-integration-dashboard",
  "version": "0.1.0",
  "description": "Offline-first academic command center for Canvas LMS",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -w",
    "dev:renderer": "vite",
    "build": "tsc && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux"
  },
  "keywords": [
    "canvas",
    "lms",
    "academic",
    "offline-first",
    "uoft",
    "electron"
  ],
  "author": "UofT Students",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "zustand": "^5.0.2",
    "winston": "^3.17.0",
    "keyring-rs": "^0.3.3",
    "axios": "^1.7.9",
    "react-hotkeys-hook": "^4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@types/node": "^22.10.5",
    "electron": "^34.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^25.2.0",
    "eslint": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "prettier": "^3.4.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "concurrently": "^9.1.2",
    "electron-is-dev": "^3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MorrisXDS/CanvasAssistant.git"
  },
  "bugs": {
    "url": "https://github.com/MorrisXDS/CanvasAssistant/issues"
  },
  "homepage": "https://github.com/MorrisXDS/CanvasAssistant#readme"
}
